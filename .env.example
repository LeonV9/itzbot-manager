# Copy to .env on the VPS and fill in. NEVER commit .env.
# Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=change-me-to-a-long-random-string
JWT_SECRET=
MASTER_KEY=

# Host directory that stores bot files. Must exist and be owned by uid 1000:
#   sudo mkdir -p /opt/itzbot/data && sudo chown -R 1000:1000 /opt/itzbot/data
HOST_DATA_DIR=/opt/itzbot/data

# Domain pointing at the VPS (Caddy gets a free HTTPS certificate for it).
# Use :80 only for local testing without TLS.
SITE_ADDRESS=bots.example.com

# Registration: the first account is always allowed. Set true only to add more users.
ALLOW_REGISTRATION=false

# Default per-bot limits (changeable in the app Settings screen)
DEFAULT_BOT_MEMORY_MB=256
DEFAULT_BOT_CPUS=0.5
